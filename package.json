{
  "name": "mcp-guard",
  "version": "1.0.0",
  "description": "Defensive security scanner for MCP servers: tool poisoning, shadowing, excessive permissions, leaked secrets and transport flaws, with SARIF output for CI.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mcp-guard": "./dist/cli/index.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist",
    "docs/rules.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "build:action": "tsup --config tsup.action.config.ts && node scripts/third-party-licenses.mjs",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepare": "tsup",
    "docs:rules": "tsx src/cli/index.ts rules --format markdown > docs/rules.md",
    "docs:screenshots": "node docs/screenshots.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "appsec",
    "sarif",
    "tool-poisoning",
    "prompt-injection",
    "scanner",
    "ci"
  ],
  "author": "Diego Pérez",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegoperezg7/mcp-guard.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
